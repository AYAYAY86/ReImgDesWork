<!DOCTYPE html>
<html lang="en">

<head>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    html {
      margin: 0px;
      padding: 0px;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    canvas {
      display: block;
      width: 540px;
      height: 675px;
      margin: 0 auto;
    }

    @font-face {
      font-family: 'MeinFont';
      src: url('fonts/Selecta Medium.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    .canvas-label {
      width: 540px;
      max-width: 100vw;
      margin: 0px -25px;
      white-space: normal;
      word-break: break-word;
      position: fixed;
      text-align: right;
      transform: translate(-50%, -50%);
      font-family:  Arial, sans-serif;
      font-size: 1.2rem;
      color: white;
      padding: 0.55em 0em;
      border-radius: 0px;
      z-index: 100;
      pointer-events: none;
    }

    .canvas-title {
      width: 540px;
      max-width: 100vw;
      margin: 0px 25px;
      position: fixed;
      text-align: left;
      transform: translate(-50%, -50%);
      font-family: Arial, sans-serif;
      font-size: 2rem;
      color: white;
      padding: 0.55em 0em;
      z-index: 100;
      pointer-events: none;
    }

    .canvas-info {
      width: 540px;
      margin: 40px 25px;
      max-width: 100vw;
      position: fixed;
      text-align: left;
      font-family: Arial, sans-serif;
      font-size: 1.2rem;
      color: white;
      padding: 0.4em 0em;
      z-index: 100;
      pointer-events: none;
    }

    .hydra-canvas {
      display: block;
      margin: 0 auto;
    }
  </style>
  <link rel="stylesheet" type="text/css" href="style.css">
  <meta charset="utf-8" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>

<body>
  <div class="canvas-title">unsorted.love</div>
  <div class="canvas-label">Session #3<br>30. August 2025<br>19h00 – 01h00<br>Josefstrasse 206</div>
  <div class="canvas-info">Pedro Neves X m-onz<br>Ted Davis X Felix Roos<br>Valentina Vuksic X Valentina Shipovskaya<br>Yoshi Kosaka X ALY-X</div>

</body>
<!-- <script src="https://unpkg.com/hydra-synth"></script> -->
<!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.3/p5.js"></script> -->
<script src="libaries/hydra-synth.js"></script>
<script src="libaries/p5.js"></script>
<script>

  let hc = document.createElement('canvas');
  hc.width = 540;
  hc.height = 675;
  hc.className = "hydra-canvas";
  document.body.appendChild(hc);

  function positionElements() {
    const canvas = document.querySelector('.hydra-canvas');
    const label = document.querySelector('.canvas-label');
    const title = document.querySelector('.canvas-title'); // <-- hier definieren!
    const info = document.querySelector('.canvas-info');

    if (canvas) {
      const rect = canvas.getBoundingClientRect();

      // Title oben auf Canvas
      if (title) {
        title.style.top = rect.top + 'px';
        title.style.left = (rect.left + rect.width / 2) + 'px';
        title.style.transform = 'translate(-50%, 0)';
      }

      // Label unter Title
      if (label) {
        label.style.top = (rect.top + rect.width/2) + 'px'; // etwas unter Title
        label.style.left = (rect.left + rect.width / 2) + 'px';
        label.style.transform = 'translate(-50%, 0)';
      }

      // Info unten im Canvas
      if (info) {
        info.style.top = (rect.bottom - 150) + 'px';
        info.style.left = (rect.left + rect.width / 2) + 'px';
        info.style.transform = 'translate(-50%, 0)';
      }
    }
  }

  // Nach Canvas-Erstellung aufrufen
  setTimeout(positionElements, 100);
  window.addEventListener('resize', positionElements);

  let hydra = new Hydra({ detectAudio: false, canvas: hc })
  // hydra.setResolution(window.innerWidth*2, window.innerHeight*2) // retina res
  noize = noise // use noize() since noise() is taken by p5js

  let pg // store hydra texture

  // sandbox - start

  src(o0)
    .layer(s0)
    //.scrollY(() => scaleSize)
    .scale(1.1)
    .scroll(0.1, 0.1, .5, .5)
    .kaleid(2)
    .kaleid(4)
    .pixelate(32, 32)

    //  .thresh(1.75,.25)

    //  .kaleid(20)
    //  .modulateRotate(osc(10,0,0).kaleid(4).scale(2.5),10,10)
    // .scrollX(1.5)
    // .kaleid(2)
    // .scale(() => scaleSize)
    .out()
  // sandbox  - stop

  let xoff = 0;
  let yoff = 1000;

  let px = 0;
  let py = 1000;

  let scaleSize


  function setup() {
    let cnv = createCanvas(windowWidth, windowHeight);
    cnv.hide(); // p5-Canvas ausblenden
    pg = createGraphics(hc.width, hc.height);
    s0.init({ src: drawingContext.canvas });
    stroke(0);
  }

  function gradientEllipse(cx, cy, r, c1, c2) {

    noStroke();
    for (let i = r; i > 0; i -= 2) {
      let inter = map(i, 0, r, 1, 0);
      let c = lerpColor(c1, c2, inter);
      fill(c);

      ellipse(cx, cy, i, i);
    }
  }



  function draw() {
    clear()
    // pixelDensity(.1)
    pg.drawingContext.drawImage(hc, 0, 0, pg.width, pg.height)

    let newMouseX = map(mouseX, 0, width, -width / 2, width / 2);
    let newMouseY = map(mouseY, 0, -height, height, 0)
    let newPmouseY = map(pmouseY, 0, -height, height, 0)

    let scaleSize = map(sin(frameCount * .01), -1, 1, 1.001, 1.005)



    fill(255, 100, 100)
    stroke(0)

    //ellipse(mouseX, newMouseY, 200)

    px = noise(xoff) * width / 2;
    py = noise(yoff) * height;

    px1 = map(sin(frameCount * 0.01), -1, 1, 0, width);
    py1 = map(sin(frameCount * 0.01), -1, 1, 0, 10);

    let x = noise(xoff) * width;
    let y = noise(yoff) * height;

    //point(mouseX, newMouseY)
    // line(pmouseX, newPmouseY, mouseX, newMouseY);
    // ellipse(px, py, 300);

    //blendMode(MULTIPLY);
    stroke(0)
    strokeWeight(py1)
    noFill()
    ellipse(width / 2, py, 300);
    ellipse(px, height / 2, 300);

    let c1 = color(255, 0, 0); // Mitte
    let c2 = color(0); // Rand
    gradientEllipse(width / 2, py, 300, c1, c2);
    gradientEllipse(px, height / 2, 300, c2, c1);




    xoff += 0.01;
    yoff += 0.01;

  }

  function mouseDragged() {
    let sw = map(sin(frameCount * 0.05), -1, 1, 3, 20); // remap to [3, 10]
    strokeWeight(sw);
    line(pmouseX, pmouseY, mouseX, mouseY);
  }

  let mediaRecorder;
  let recordedChunks = [];

  function startRecording() {
    const canvas = document.querySelector('.hydra-canvas');
    const stream = canvas.captureStream(30); // 30 FPS

    mediaRecorder = new MediaRecorder(stream, {
      mimeType: 'video/webm;codecs=vp9'
    });

    mediaRecorder.ondataavailable = event => {
      if (event.data.size > 0) {
        recordedChunks.push(event.data);
      }
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'canvas-recording.webm';
      a.click();
      recordedChunks = [];
    };

    mediaRecorder.start();
    console.log('Recording started...');
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
      console.log('Recording stopped');
    }
  }

  async function startScreenRecording() {
    try {
      const stream = await navigator.mediaDevices.getDisplayMedia({
        video: { mediaSource: 'screen' },
        audio: false
      });
      
      mediaRecorder = new MediaRecorder(stream, {
        mimeType: 'video/webm;codecs=vp9'
      });
      
      mediaRecorder.ondataavailable = event => {
        if (event.data.size > 0) {
          recordedChunks.push(event.data);
        }
      };
      
      mediaRecorder.onstop = () => {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'screen-recording.webm';
        a.click();
        recordedChunks = [];
      };
      
      mediaRecorder.start();
      console.log('Screen recording started...');
    } catch (err) {
      console.error('Error starting screen recording:', err);
    }
  }

  async function startCompositeRecording() {
    const canvas = document.querySelector('.hydra-canvas');
    const compositeCanvas = document.createElement('canvas');
    compositeCanvas.width = canvas.width;
    compositeCanvas.height = canvas.height;
    const ctx = compositeCanvas.getContext('2d');
    
    // Animation Loop für Composite Canvas
    function captureFrame() {
      if (!mediaRecorder || mediaRecorder.state !== 'recording') return;
      
      // 1. Hydra Canvas zeichnen
      ctx.drawImage(canvas, 0, 0);
      
      // 2. HTML Elements als Bild darüber zeichnen
      html2canvas(document.body, {
        canvas: compositeCanvas,
        backgroundColor: null,
        allowTaint: true,
        useCORS: true,
        scale: 1
      }).then(() => {
        requestAnimationFrame(captureFrame);
      });
    }
    
    // Stream vom Composite Canvas starten
    const stream = compositeCanvas.captureStream(30);
    
    mediaRecorder = new MediaRecorder(stream, {
      mimeType: 'video/webm;codecs=vp9'
    });
    
    mediaRecorder.ondataavailable = event => {
      if (event.data.size > 0) {
        recordedChunks.push(event.data);
      }
    };
    
    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'composite-recording.webv';
      a.click();
      recordedChunks = [];
    };
    
    mediaRecorder.start();
    captureFrame(); // Animation starten
    console.log('Composite recording started...');
  }

  // Tastenkürzel erweitern
  function keyPressed() {
    if (key == 'R') startScreenRecording();
    if (key == 'C') startCompositeRecording(); // <-- Composite Mode
    if (key == 'S') stopRecording();
    if (key == 'P') pg.save('P5LIVE_hydra.png');
  }

</script>

</html>